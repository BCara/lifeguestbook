# Web build settings. Copy to .env.production.local (git-ignored) or set them in CI.
# All optional: empty keeps the feature off. See docs/monitoring.md.
VITE_SENTRY_DSN=
# VITE_SENTRY_ENVIRONMENT=production
# GA4 measurement ID (G-XXXXXXX). Only loaded after the visitor accepts analytics cookies.
VITE_GA_MEASUREMENT_ID=
# Build-time only (never VITE_*): source map upload to Sentry happens only when the token is set.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT_WEB=
# SENTRY_RELEASE=   # defaults to lifeguestbook@<git sha>
