# Copy to .env (never commit it) or set these on your host.

# Required in production. Everyone who knows this can get in.
STUDIO_PASSCODE=pick-something-long-and-memorable
# Long random string. Run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Switches on real AI. Without it the AI features run in clearly labelled demo mode.
ANTHROPIC_API_KEY=
# Optional. Change the model without touching code.
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (higher = more thorough, slower, pricier)
AI_EFFORT=medium

# Storage: "file" (default, needs a persistent disk) or "firestore" (Cloud Run / Firebase).
STORE=file
DATA_FILE=./data/studio.json
# FIRESTORE_PREFIX=bc
