{
  "name": "lifeguestbook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "setup:emulators": "node scripts/setup-emulators.mjs",
    "predev": "npm run build",
    "dev": "concurrently -k -n web,fn,emu -c cyan,yellow,magenta \"npm:dev:web\" \"npm:dev:functions\" \"npm:dev:emulators\"",
    "dev:web": "vite",
    "dev:functions": "npm --prefix functions run build:watch",
    "predev:emulators": "npm run setup:emulators",
    "dev:emulators": "firebase emulators:start --project demo-lifeguestbook --import .firebase/emulator-data --export-on-exit",
    "build": "vite build && npm --prefix functions run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix functions run typecheck",
    "test": "vitest run",
    "pretest:smoke": "npm run setup:emulators",
    "test:smoke": "npm --prefix functions run build && firebase emulators:exec --project demo-lifeguestbook --only functions,firestore,storage \"node scripts/smoke.mjs\"",
    "deploy": "npm run build && firebase deploy --only hosting,functions,firestore,storage"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.0",
    "firebase-tools": "^15.25.0",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
