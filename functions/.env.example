# Copy to functions/.env (deploy) or functions/.env.local (emulators).
APP_ORIGIN=https://lifeguestbook.com
EMAIL_FROM=Life Guestbook <hello@lifeguestbook.com>
EMAIL_REPLY_TO=hello@lifeguestbook.com
# true turns on Google Vision SafeSearch + Natural Language moderation (deployed only).
SCREENING_ENABLED=false
# Secrets (firebase functions:secrets:set NAME; locally in functions/.secret.local):
# RESEND_API_KEY, STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET  — use "none" to keep a feature off.
